<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: dane aplikacji (adres komputera, instalki) nie trafiają do kopii w chmurze
     ani na nowy telefon. Po przeniesieniu telefon paruje się od nowa. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
